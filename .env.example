# AI Bridge X – Local Environment Variables Template (Optional Overrides)
# ------------------------------------------------------------------
# No paid API keys are required when using free local Ollama!
# If you want custom local settings, copy this file to ".env".
# ------------------------------------------------------------------

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_TIMEOUT_SECONDS=60

# Authentication & Security (set strong random value in production)
# BRIDGEX_JWT_SECRET=replace-with-at-least-32-random-bytes
BRIDGEX_JWT_EXPIRE_MINUTES=60
BRIDGEX_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
# Optional custom SQLite database file path (defaults to data/bridgex.db)
# BRIDGEX_DB_PATH=data/bridgex.db
# Optional one-time initial Administrator bootstrap from environment variables
# BRIDGEX_ADMIN_USERNAME=
# BRIDGEX_ADMIN_EMAIL=
# BRIDGEX_ADMIN_PASSWORD=
